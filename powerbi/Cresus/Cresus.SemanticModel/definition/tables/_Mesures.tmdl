table _Mesures
	lineageTag: 4e34e20c90e9c527fafa

	measure 'Encaissements (EUR)' = SUM ( fct_position_tresorerie_quotidienne[encaissements_eur] )
		formatString: #,0
		displayFolder: 1. flux
		lineageTag: f82b49a14762889abcfb

	measure 'Décaissements (EUR)' = SUM ( fct_position_tresorerie_quotidienne[decaissements_eur] )
		formatString: #,0
		displayFolder: 1. flux
		lineageTag: ce22a83aa3b068796c6a

	measure 'Date d''arrêté' = CALCULATE ( MAX ( fct_position_tresorerie_quotidienne[date_position] ) )
		formatString: dd/mm/yyyy
		displayFolder: 2. position (semi-additive)
		lineageTag: 2f933ab549bc5da964a9

	measure 'Position de trésorerie (EUR)' =
			VAR DerniereDate = [Date d'arrêté]
			RETURN
			    CALCULATE (
			        SUM ( fct_position_tresorerie_quotidienne[position_cloture_eur] ),
			        dim_date[date_jour] = DerniereDate
			    )
		formatString: #,0
		displayFolder: 2. position (semi-additive)
		lineageTag: 4191be959d8b03972290

	measure 'Encours de dépôts (EUR)' =
			VAR DerniereDate = [Date d'arrêté]
			RETURN
			    CALCULATE (
			        SUM ( fct_position_tresorerie_quotidienne[encours_depots_eur] ),
			        dim_date[date_jour] = DerniereDate
			    )
		formatString: #,0
		displayFolder: 2. position (semi-additive)
		lineageTag: 05ec855efbe7b482758b

	measure 'Effet de change cumulé (EUR)' =
			VAR DerniereDate = [Date d'arrêté]
			RETURN
			    CALCULATE (
			        SUM ( fct_position_tresorerie_quotidienne[effet_change_eur] ),
			        dim_date[date_jour] = DerniereDate
			    )
		formatString: #,0
		displayFolder: 4. risque de change
		lineageTag: 0b0d904b0262d5a7567e

	measure 'Besoin de liquidité 30 j (EUR)' =
			VAR DerniereDate = [Date d'arrêté]
			RETURN
			    CALCULATE ( SUM ( mart_liquidite_placement[besoin_liquidite_30j_eur] ), dim_date[date_jour] = DerniereDate )
		formatString: #,0
		displayFolder: 3. liquidité, placement, refinancement
		lineageTag: 4e05f01446e4812394b7

	measure 'Ratio de couverture liquidité %' = DIVIDE ( [Position de trésorerie (EUR)], [Besoin de liquidité 30 j (EUR)] )
		formatString: 0.0 %
		displayFolder: 3. liquidité, placement, refinancement
		lineageTag: a42e4eb67e169210316d

	measure 'Jours sous 100 %' = CALCULATE ( COUNTROWS ( mart_liquidite_placement ), mart_liquidite_placement[ratio_couverture_liquidite_pct] < 100 )
		formatString: 0
		displayFolder: 3. liquidité, placement, refinancement
		lineageTag: 9e761d4601db37c7b47e

	measure 'Refinancement levé (EUR)' =
			CALCULATE ( SUM ( fct_position_tresorerie_quotidienne[operation_tresorerie_eur] ),
			            fct_position_tresorerie_quotidienne[operation_tresorerie_eur] > 0 )
		formatString: #,0
		displayFolder: 3. liquidité, placement, refinancement
		lineageTag: 084f20df1646b5b9fa9b

	measure 'Excédent placé (EUR)' =
			- CALCULATE ( SUM ( fct_position_tresorerie_quotidienne[operation_tresorerie_eur] ),
			              fct_position_tresorerie_quotidienne[operation_tresorerie_eur] < 0 )
		formatString: #,0
		displayFolder: 3. liquidité, placement, refinancement
		lineageTag: 4c9df02143bb465e77ae

	measure 'Coût annuel de couverture de change (EUR)' =
			VAR DerniereDate = [Date d'arrêté]
			RETURN
			    CALCULATE ( SUM ( mart_liquidite_placement[cout_couverture_change_annuel_eur] ), dim_date[date_jour] = DerniereDate )
		formatString: #,0
		displayFolder: 3. liquidité, placement, refinancement
		lineageTag: 2fef17b527a2c8150947

	measure 'Exposition au change (EUR)' =
			VAR DerniereDate = CALCULATE ( MAX ( mart_exposition_change[date_position] ) )
			RETURN
			    CALCULATE ( SUM ( mart_exposition_change[exposition_eur] ), dim_date[date_jour] = DerniereDate )
		formatString: #,0
		displayFolder: 4. risque de change
		lineageTag: cfe198d9dbae49b48ee3

	measure 'VaR change 95 % 10 j (EUR)' =
			VAR DerniereDate = CALCULATE ( MAX ( mart_exposition_change[date_position] ) )
			RETURN
			    SUMX (
			        VALUES ( dim_filiale[code_devise] ),
			        VAR Devise = dim_filiale[code_devise]
			        RETURN
			            CALCULATE (
			                SUM ( mart_exposition_change[var_95_10j_eur] ),
			                dim_date[date_jour] = DerniereDate,
			                mart_exposition_change[code_devise] = Devise
			            )
			    )
		formatString: #,0
		displayFolder: 4. risque de change
		lineageTag: 430e0fab97302e9d04d1

	measure 'Recommandation de couverture' =
			VAR DerniereDate = CALCULATE ( MAX ( mart_exposition_change[date_position] ) )
			RETURN CALCULATE ( SELECTEDVALUE ( mart_exposition_change[recommandation_couverture] ), dim_date[date_jour] = DerniereDate )
		displayFolder: 4. risque de change
		lineageTag: efd197eb5e47af1fae32

	measure 'Encours réel publié (devise)' =
			VAR Filiale = SELECTEDVALUE ( dim_filiale[code_filiale], "FR" )
			RETURN CALCULATE ( SUM ( mart_qualite_ancrage[encours_reel_devise] ), REMOVEFILTERS ( dim_filiale ), dim_filiale[code_filiale] = Filiale )
		formatString: #,0
		displayFolder: 7. qualité des données sources (etl)
		lineageTag: 450982820203e722d3f0

	measure 'Encours reconstitué (devise)' =
			VAR Filiale = SELECTEDVALUE ( dim_filiale[code_filiale], "FR" )
			RETURN CALCULATE ( SUM ( mart_qualite_ancrage[encours_reconstitue_devise] ), REMOVEFILTERS ( dim_filiale ), dim_filiale[code_filiale] = Filiale )
		formatString: #,0
		displayFolder: 7. qualité des données sources (etl)
		lineageTag: 0e299c28fb605d9121e0

	measure 'Position prévue P50 (EUR)' = SUM ( mart_prevision_tresorerie[position_p50_eur] )
		formatString: #,0
		displayFolder: 5. prévision
		lineageTag: 5ac90a75ca4e2dcdef46

	measure 'Position prévue P05 (EUR)' = SUM ( mart_prevision_tresorerie[position_p05_eur] )
		formatString: #,0
		displayFolder: 5. prévision
		lineageTag: 4edd5a11c506c22fedc0

	measure 'Position prévue P95 (EUR)' = SUM ( mart_prevision_tresorerie[position_p95_eur] )
		formatString: #,0
		displayFolder: 5. prévision
		lineageTag: 98bb784a65d78c212a6b

	measure 'Probabilité de passer sous le besoin de liquidité %' =
			MAXX (
			    VALUES ( dim_filiale[code_filiale] ),
			    CALCULATE ( MAX ( mart_prevision_tresorerie[proba_sous_besoin_liquidite] ) )
			)
		formatString: 0.0 %
		displayFolder: 5. prévision
		lineageTag: b9be5f17566b3e64df9f

	measure 'WAPE du modèle champion %' =
			CALCULATE (
			    DIVIDE (
			        SUMX ( mart_backtest_journalier, ABS ( mart_backtest_journalier[reel_eur] - mart_backtest_journalier[prevu_eur] ) ),
			        SUM ( mart_backtest_journalier[reel_eur] )
			    ),
			    mart_backtest_journalier[est_champion] = TRUE ()
			)
		formatString: 0.0 %
		displayFolder: 5. prévision
		lineageTag: 88ed0c8ad2f55e056ce8

	measure 'Taux de change prévu P50' =
			VAR Devise = SELECTEDVALUE ( dim_devise[code_devise], "USD" )
			RETURN CALCULATE ( AVERAGE ( mart_prevision_change[taux_p50] ), dim_devise[code_devise] = Devise )
		formatString: 0.0000
		displayFolder: 5. prévision
		lineageTag: b0e4d54ad3f07e64c671

	measure 'Taux de change prévu P05' =
			VAR Devise = SELECTEDVALUE ( dim_devise[code_devise], "USD" )
			RETURN CALCULATE ( AVERAGE ( mart_prevision_change[taux_p05] ), dim_devise[code_devise] = Devise )
		formatString: 0.0000
		displayFolder: 5. prévision
		lineageTag: cc9aca89b00688c3e7ff

	measure 'Taux de change prévu P95' =
			VAR Devise = SELECTEDVALUE ( dim_devise[code_devise], "USD" )
			RETURN CALCULATE ( AVERAGE ( mart_prevision_change[taux_p95] ), dim_devise[code_devise] = Devise )
		formatString: 0.0000
		displayFolder: 5. prévision
		lineageTag: a89014190e8fe295f27c

	measure 'Taux de change réalisé' =
			VAR Devise = SELECTEDVALUE ( dim_devise[code_devise], "USD" )
			RETURN CALCULATE ( AVERAGE ( mart_prevision_change[taux_realise] ), dim_devise[code_devise] = Devise )
		formatString: 0.0000
		displayFolder: 5. prévision
		lineageTag: d6c44db9c917df59e825

	measure 'Facteur choc change' = IF ( SELECTEDVALUE ( dim_filiale[code_devise] ) = "EUR", 1, 1 + [Valeur Choc change %] / 100 )
		formatString: 0.00
		displayFolder: 6. simulateur de stress (what-if)
		lineageTag: 49e614f261a7984472e1

	measure 'Position stressée (EUR)' =
			SUMX (
			    VALUES ( dim_filiale[code_filiale] ),
			    ( [Position de trésorerie (EUR)] - [Encours de dépôts (EUR)] * [Valeur Choc retraits %] / 100 )
			        * [Facteur choc change]
			)
		formatString: #,0
		displayFolder: 6. simulateur de stress (what-if)
		lineageTag: b03f0f16e7604ee64216

	measure 'Flux net quotidien stressé (EUR)' =
			VAR DerniereDate = [Date d'arrêté]
			VAR Fenetre = DATESINPERIOD ( dim_date[date_jour], DerniereDate, -30, DAY )
			RETURN
			    SUMX (
			        VALUES ( dim_filiale[code_filiale] ),
			        VAR Enc = CALCULATE ( AVERAGE ( fct_position_tresorerie_quotidienne[encaissements_eur] ), Fenetre )
			        VAR Dec = CALCULATE ( AVERAGE ( fct_position_tresorerie_quotidienne[decaissements_eur] ), Fenetre )
			        RETURN ( Enc - Dec * [Valeur Multiplicateur sorties] ) * [Facteur choc change]
			    )
		formatString: #,0
		displayFolder: 6. simulateur de stress (what-if)
		lineageTag: e6f837c41dac00b4137b

	measure 'Horizon de survie (jours)' =
			VAR Pos = [Position stressée (EUR)]
			VAR Net = [Flux net quotidien stressé (EUR)]
			RETURN
			    SWITCH ( TRUE (), Pos <= 0, 0, Net >= 0, BLANK (), DIVIDE ( Pos, -Net ) )
		formatString: 0.0
		displayFolder: 6. simulateur de stress (what-if)
		lineageTag: ce3e26f6d9c0ee74ebc2

	measure 'Besoin de refinancement stressé (EUR)' =
			SUMX (
			    VALUES ( dim_filiale[code_filiale] ),
			    MAX ( 0, - [Flux net quotidien stressé (EUR)] * 30 - [Position stressée (EUR)] )
			)
		formatString: #,0
		displayFolder: 6. simulateur de stress (what-if)
		lineageTag: be6eb707d77b40847351

	measure 'Coût du refinancement stressé (EUR/an)' =
			VAR DerniereDate = [Date d'arrêté]
			RETURN
			    SUMX (
			        VALUES ( dim_filiale[code_filiale] ),
			        VAR Taux =
			            CALCULATE ( MAX ( mart_liquidite_placement[taux_directeur_local_pct] ), dim_date[date_jour] = DerniereDate )
			        RETURN [Besoin de refinancement stressé (EUR)] * ( Taux + 0.5 + [Valeur Choc taux (pb)] / 100 ) / 100
			    )
		formatString: #,0
		displayFolder: 6. simulateur de stress (what-if)
		lineageTag: 2a1c54186764b81400f0

	measure 'Statut de résilience' =
			VAR Pos = [Position stressée (EUR)]
			VAR H = [Horizon de survie (jours)]
			RETURN
			    SWITCH (
			        TRUE (),
			        Pos <= 0, "Critique",
			        ISBLANK ( H ) || H >= 30, "Résilient",
			        H >= 7, "Vigilance",
			        "Critique"
			    )
		displayFolder: 6. simulateur de stress (what-if)
		lineageTag: ba7e94321aa1ae44b0e7

	measure 'Lignes brutes reçues' = SUM ( mart_qualite_sources[nb_lignes_brutes] )
		formatString: #,0
		displayFolder: 7. qualité des données sources (etl)
		lineageTag: 5786ac53f3591455505b

	measure 'Lignes retenues après nettoyage' = SUM ( mart_qualite_sources[nb_lignes_retenues] )
		formatString: #,0
		displayFolder: 7. qualité des données sources (etl)
		lineageTag: b4f5c82582793a0c384e

	measure 'Taux de rejet %' = DIVIDE ( [Lignes brutes reçues] - [Lignes retenues après nettoyage], [Lignes brutes reçues] )
		formatString: 0.0 %
		displayFolder: 7. qualité des données sources (etl)
		lineageTag: 998f8222f89579341407

	measure 'Doublons supprimés' = SUM ( mart_qualite_sources[nb_doublons] )
		formatString: #,0
		displayFolder: 7. qualité des données sources (etl)
		lineageTag: 229a21f1492498213abb

	measure 'Libellés corrigés' = SUM ( mart_qualite_sources[nb_libelles_corriges] )
		formatString: #,0
		displayFolder: 7. qualité des données sources (etl)
		lineageTag: 3134496956e67832a6ff

	measure 'Devises corrigées' = SUM ( mart_qualite_sources[nb_devises_corrigees] )
		formatString: #,0
		displayFolder: 7. qualité des données sources (etl)
		lineageTag: 2f400783aece74698f63

	measure 'Opérations annulées, tests et extournes écartés' = SUM ( mart_qualite_sources[nb_annulees] ) + SUM ( mart_qualite_sources[nb_comptes_test] ) + SUM ( mart_qualite_sources[nb_extournes] )
		formatString: #,0
		displayFolder: 7. qualité des données sources (etl)
		lineageTag: 8d0a64d17344b7fe6972

	measure 'Filiales critiques' = CALCULATE ( COUNTROWS ( mart_stress_test ), mart_stress_test[statut_resilience] = "3 - Critique" ) + 0
		formatString: #,0
		displayFolder: 6. simulateur de stress (what-if)
		lineageTag: ce3bf2021d8fe575f2be

	column Masque
		isHidden
		lineageTag: 68072c10cf8ca5cfc641
		summarizeBy: none
		isNameInferred
		sourceColumn: [Masque]

	partition _Mesures = calculated
		mode: import
		source = ROW("Masque", 1)


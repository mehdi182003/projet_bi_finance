model Model
	culture: fr-FR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: fr-FR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["dim_date","dim_filiale","dim_devise","dim_type_transaction","dim_scenario_stress","fct_flux_tresorerie_horaire","fct_position_tresorerie_quotidienne","fct_taux_change","mart_exposition_change","mart_liquidite_placement","mart_stress_test","mart_prevision_tresorerie","mart_prevision_change","mart_qualite_prevision","mart_backtest_journalier","mart_qualite_donnees","mart_qualite_ancrage","mart_reserve_optimale","mart_controle_a_posteriori","mart_qualite_sources","ServeurPostgres","BasePostgres"]

ref table dim_date
ref table dim_filiale
ref table dim_devise
ref table dim_type_transaction
ref table dim_scenario_stress
ref table fct_flux_tresorerie_horaire
ref table fct_position_tresorerie_quotidienne
ref table fct_taux_change
ref table mart_exposition_change
ref table mart_liquidite_placement
ref table mart_stress_test
ref table mart_prevision_tresorerie
ref table mart_prevision_change
ref table mart_qualite_prevision
ref table mart_backtest_journalier
ref table mart_qualite_donnees
ref table mart_qualite_ancrage
ref table mart_reserve_optimale
ref table mart_controle_a_posteriori
ref table mart_qualite_sources
ref table _Mesures
ref table 'Choc retraits %'
ref table 'Choc change %'
ref table 'Multiplicateur sorties'
ref table 'Choc taux (pb)'
ref table 'Devises choquées'


// =============================================================================
//  Projet Crésus - ZF Banque : mesures DAX du cockpit de trésorerie
//  À créer dans une table vide « _Mesures » (Accueil > Entrer des données > OK).
//  Les tables du schéma marts sont supposées renommées sans le préfixe « marts ».
// =============================================================================

// ---------------------------------------------------------------- 1. FLUX
Encaissements (EUR) = SUM ( fct_flux_tresorerie_horaire[encaissements_eur] )

Décaissements (EUR) = SUM ( fct_flux_tresorerie_horaire[decaissements_eur] )

Solde net (EUR) = SUM ( fct_flux_tresorerie_horaire[flux_net_eur] )

Solde net quotidien moyen (EUR) =
AVERAGEX ( VALUES ( dim_date[date_jour] ), [Solde net (EUR)] )

Nb opérations = SUM ( fct_flux_tresorerie_horaire[nb_mouvements] )

Décaissements frauduleux (EUR) =
CALCULATE ( [Décaissements (EUR)], fct_flux_tresorerie_horaire[est_fraude] = TRUE () )

// Fraude : à placer sur la page Qualité / Risques, PAS dans le temps (fraude injectée à rythme constant
// par PaySim : son « taux » quotidien est un artefact). Voir aussi mart_qualite_donnees.
Taux de fraude % = DIVIDE ( [Décaissements frauduleux (EUR)], [Décaissements (EUR)] )

Taux de détection actuel % =
DIVIDE ( SUM ( mart_qualite_donnees[nb_fraudes_signalees] ), SUM ( mart_qualite_donnees[nb_fraudes] ) )

Rappel de la règle « vide le compte » % =
DIVIDE ( SUM ( mart_qualite_donnees[nb_fraudes_detectees_regle] ), SUM ( mart_qualite_donnees[nb_fraudes] ) )

// Concentration : sur 2023-2025, les opérations de 10 k EUR et plus pèsent ~14 % des montants décaissés
Part des gros décaissements % =
DIVIDE ( SUM ( fct_position_tresorerie_quotidienne[decaissements_gros_tickets_eur] ), [Décaissements (EUR)] )

// ------------------------------------------------- 2. POSITION (semi-additive)
// Une position est un STOCK : on ne l'additionne pas dans le temps,
// on prend la valeur du dernier jour de la période filtrée.
Date d'arrêté =
CALCULATE ( MAX ( fct_position_tresorerie_quotidienne[date_position] ) )

Position de trésorerie (EUR) =
VAR DerniereDate = [Date d'arrêté]
RETURN
    CALCULATE (
        SUM ( fct_position_tresorerie_quotidienne[position_cloture_eur] ),
        dim_date[date_jour] = DerniereDate
    )

Position début de période (EUR) =
VAR PremiereDate = CALCULATE ( MIN ( fct_position_tresorerie_quotidienne[date_position] ) )
RETURN
    CALCULATE (
        SUMX (
            fct_position_tresorerie_quotidienne,
            fct_position_tresorerie_quotidienne[position_ouverture_devise]
                / fct_position_tresorerie_quotidienne[taux_eur_jour]
        ),
        dim_date[date_jour] = PremiereDate
    )

Variation de position % =
DIVIDE ( [Position de trésorerie (EUR)] - [Position début de période (EUR)], [Position début de période (EUR)] )

Encours de dépôts (EUR) =
VAR DerniereDate = [Date d'arrêté]
RETURN
    CALCULATE (
        SUM ( fct_position_tresorerie_quotidienne[encours_depots_eur] ),
        dim_date[date_jour] = DerniereDate
    )

Effet de change cumulé (EUR) =
VAR DerniereDate = [Date d'arrêté]
RETURN
    CALCULATE (
        SUM ( fct_position_tresorerie_quotidienne[effet_change_eur] ),
        dim_date[date_jour] = DerniereDate
    )

// --------------------------------------- 3. LIQUIDITÉ, PLACEMENT, REFINANCEMENT
Besoin de liquidité 30 j (EUR) =
VAR DerniereDate = [Date d'arrêté]
RETURN
    CALCULATE ( SUM ( mart_liquidite_placement[besoin_liquidite_30j_eur] ), dim_date[date_jour] = DerniereDate )

// LCR simplifié Bâle III : position / (10 % des dépôts). Seuil réglementaire 100 %, pilotage 110 %.
Ratio de couverture liquidité % =
DIVIDE ( [Position de trésorerie (EUR)], [Besoin de liquidité 30 j (EUR)] )

// Vitesse à laquelle la réserve se consomme (moyenne glissante 30 j)
Consommation quotidienne de la position % =
VAR DerniereDate = [Date d'arrêté]
VAR FluxMoyen = CALCULATE ( SUM ( mart_liquidite_placement[flux_net_moyen_eur] ), dim_date[date_jour] = DerniereDate )
RETURN DIVIDE ( -FluxMoyen, [Position de trésorerie (EUR)] )

// KPI d'anticipation : dans combien de jours la filiale passe sous 100 % (0 = déjà en dessous).
// Au niveau groupe on affiche la filiale la plus exposée (minimum).
Jours avant passage sous 100 % =
VAR DerniereDate = [Date d'arrêté]
RETURN
    MINX (
        VALUES ( dim_filiale[code_filiale] ),
        CALCULATE ( MIN ( mart_liquidite_placement[jours_avant_seuil_100pct] ), dim_date[date_jour] = DerniereDate )
    )

Jours sous 100 % =
CALCULATE ( COUNTROWS ( mart_liquidite_placement ), mart_liquidite_placement[ratio_couverture_liquidite_pct] < 100 )

// Opérations de trésorerie de fin de mois (rééquilibrage de la réserve vers sa cible)
Refinancement levé (EUR) =
CALCULATE ( SUM ( fct_position_tresorerie_quotidienne[operation_tresorerie_eur] ),
            fct_position_tresorerie_quotidienne[operation_tresorerie_eur] > 0 )

Excédent placé (EUR) =
- CALCULATE ( SUM ( fct_position_tresorerie_quotidienne[operation_tresorerie_eur] ),
              fct_position_tresorerie_quotidienne[operation_tresorerie_eur] < 0 )

Économie annuelle grâce à l'anticipation (EUR) =
VAR DerniereDate = [Date d'arrêté]
RETURN
    CALCULATE ( SUM ( mart_liquidite_placement[economie_anticipation_annuelle_eur] ), dim_date[date_jour] = DerniereDate )

Liquidité excédentaire (EUR) =
VAR DerniereDate = [Date d'arrêté]
RETURN
    CALCULATE ( SUM ( mart_liquidite_placement[liquidite_excedentaire_eur] ), dim_date[date_jour] = DerniereDate )

Gain annuel de placement (EUR) =
VAR DerniereDate = [Date d'arrêté]
RETURN
    CALCULATE ( SUM ( mart_liquidite_placement[gain_placement_annuel_eur] ), dim_date[date_jour] = DerniereDate )

Besoin de refinancement (EUR) =
VAR DerniereDate = [Date d'arrêté]
RETURN
    CALCULATE ( SUM ( mart_liquidite_placement[besoin_refinancement_eur] ), dim_date[date_jour] = DerniereDate )

Coût annuel de refinancement (EUR) =
VAR DerniereDate = [Date d'arrêté]
RETURN
    CALCULATE ( SUM ( mart_liquidite_placement[cout_refinancement_annuel_eur] ), dim_date[date_jour] = DerniereDate )

Coût annuel de couverture de change (EUR) =
VAR DerniereDate = [Date d'arrêté]
RETURN
    CALCULATE ( SUM ( mart_liquidite_placement[cout_couverture_change_annuel_eur] ), dim_date[date_jour] = DerniereDate )

// Indicateur de synthèse « centre de profit » : gains de placement - coûts
Résultat net de trésorerie annuel (EUR) =
[Gain annuel de placement (EUR)] - [Coût annuel de refinancement (EUR)] - [Coût annuel de couverture de change (EUR)]

// ------------------------------------------------------- 4. RISQUE DE CHANGE
Exposition au change (EUR) =
VAR DerniereDate = CALCULATE ( MAX ( mart_exposition_change[date_position] ) )
RETURN
    CALCULATE ( SUM ( mart_exposition_change[exposition_eur] ), dim_date[date_jour] = DerniereDate )

Part de la position en devises % =
DIVIDE ( [Exposition au change (EUR)], [Position de trésorerie (EUR)] )

VaR change 95 % 10 j (EUR) =
VAR DerniereDate = CALCULATE ( MAX ( mart_exposition_change[date_position] ) )
RETURN
    CALCULATE ( SUM ( mart_exposition_change[var_95_10j_eur] ), dim_date[date_jour] = DerniereDate )

// Décision de couverture : coût annuel (différentiel de taux) / volatilité annuelle, par devise
// À afficher PAR DEVISE uniquement (une moyenne de ratios entre devises n'a pas de sens)
Rapport coût / risque de la couverture =
VAR DerniereDate = CALCULATE ( MAX ( mart_exposition_change[date_position] ) )
RETURN
    IF (
        HASONEVALUE ( mart_exposition_change[code_devise] ),
        CALCULATE ( AVERAGE ( mart_exposition_change[rapport_cout_risque] ), dim_date[date_jour] = DerniereDate )
    )

Recommandation de couverture =
VAR DerniereDate = CALCULATE ( MAX ( mart_exposition_change[date_position] ) )
RETURN CALCULATE ( SELECTEDVALUE ( mart_exposition_change[recommandation_couverture] ), dim_date[date_jour] = DerniereDate )

Taux EUR -> devise = AVERAGE ( fct_taux_change[taux_eur] )

Volatilité annualisée % = AVERAGE ( fct_taux_change[volatilite_annualisee_pct] ) / 100

// --------------------------------------------------------------- 5. PRÉVISION
// Réserve requise pour le mois prévu (P99 des trajectoires simulées) vs réserve actuelle
Réserve requise P99 % = AVERAGE ( mart_reserve_optimale[reserve_requise_p99_pct] ) / 100
Réserve actuelle % = AVERAGE ( mart_reserve_optimale[taux_reserve_actuel_pct] ) / 100
Liquidité libérable ou à lever (EUR) = SUM ( mart_reserve_optimale[liquidite_liberable_eur] )
Gain ou coût annuel de la réserve optimisée (EUR) = SUM ( mart_reserve_optimale[gain_annuel_eur] )

// Contrôle a posteriori sur les dépôts réels publiés après la date d'arrêté
Couverture de l'intervalle à 90 % % =
DIVIDE ( CALCULATE ( COUNTROWS ( mart_controle_a_posteriori ), mart_controle_a_posteriori[dans_intervalle_90] = TRUE () ),
         COUNTROWS ( mart_controle_a_posteriori ) )
Erreur médiane absolue sur les dépôts % =
MEDIANX ( mart_controle_a_posteriori, ABS ( mart_controle_a_posteriori[erreur_p50_pct] ) ) / 100

// Fiabilité : encours réel publié (banques centrales) vs encours reconstitué
Écart max à l'encours réel % = MAXX ( mart_qualite_ancrage, ABS ( mart_qualite_ancrage[ecart_pct] ) ) / 100

// Encours en devise locale : une somme entre filiales mélangerait les devises. Sans filiale choisie : la France.
Encours réel publié (devise) =
VAR Filiale = SELECTEDVALUE ( dim_filiale[code_filiale], "FR" )
RETURN CALCULATE ( SUM ( mart_qualite_ancrage[encours_reel_devise] ), REMOVEFILTERS ( dim_filiale ), dim_filiale[code_filiale] = Filiale )

Encours reconstitué (devise) =
VAR Filiale = SELECTEDVALUE ( dim_filiale[code_filiale], "FR" )
RETURN CALCULATE ( SUM ( mart_qualite_ancrage[encours_reconstitue_devise] ), REMOVEFILTERS ( dim_filiale ), dim_filiale[code_filiale] = Filiale )

Position prévue P50 (EUR) = SUM ( mart_prevision_tresorerie[position_p50_eur] )
Position prévue P05 (EUR) = SUM ( mart_prevision_tresorerie[position_p05_eur] )
Position prévue P95 (EUR) = SUM ( mart_prevision_tresorerie[position_p95_eur] )
// NB : au niveau groupe, la somme des P05 des filiales est une borne PRUDENTE
// (elle suppose que toutes les filiales subissent leur mauvais scénario en même temps).

Probabilité de passer sous le besoin de liquidité % =
MAXX (
    VALUES ( dim_filiale[code_filiale] ),
    CALCULATE ( MAX ( mart_prevision_tresorerie[proba_sous_besoin_liquidite] ) )
)

// WAPE pondéré (Σ|réel − prévu| / Σ réel) plutôt qu'une moyenne de WAPE par série (moyenne de moyennes).
// Montants en devise locale : à lire par filiale (au total groupe, l'écart mesuré vs pondération EUR est < 0,1 pt).
WAPE du modèle champion % =
CALCULATE (
    DIVIDE (
        SUMX ( mart_backtest_journalier, ABS ( mart_backtest_journalier[reel_devise] - mart_backtest_journalier[prevu_devise] ) ),
        SUM ( mart_backtest_journalier[reel_devise] )
    ),
    mart_backtest_journalier[est_champion] = TRUE ()
)

// Une moyenne de taux entre devises n'a pas de sens. Sans devise choisie : l'USD.
Taux de change prévu P50 =
VAR Devise = SELECTEDVALUE ( dim_devise[code_devise], "USD" )
RETURN CALCULATE ( AVERAGE ( mart_prevision_change[taux_p50] ), dim_devise[code_devise] = Devise )

Taux de change prévu P05 =
VAR Devise = SELECTEDVALUE ( dim_devise[code_devise], "USD" )
RETURN CALCULATE ( AVERAGE ( mart_prevision_change[taux_p05] ), dim_devise[code_devise] = Devise )

Taux de change prévu P95 =
VAR Devise = SELECTEDVALUE ( dim_devise[code_devise], "USD" )
RETURN CALCULATE ( AVERAGE ( mart_prevision_change[taux_p95] ), dim_devise[code_devise] = Devise )

Taux de change réalisé =
VAR Devise = SELECTEDVALUE ( dim_devise[code_devise], "USD" )
RETURN CALCULATE ( AVERAGE ( mart_prevision_change[taux_realise] ), dim_devise[code_devise] = Devise )

// ------------------------------------------- 6. SIMULATEUR DE STRESS (What-if)
// Créer d'abord 4 paramètres : Modélisation > Nouveau paramètre > Plage numérique
//   « Choc retraits % »        : 0 à 30, pas 1,    défaut 0
//   « Choc change % »          : -50 à 20, pas 1,  défaut 0
//   « Multiplicateur sorties » : 1 à 3, pas 0,1,   défaut 1
//   « Choc taux (pb) »         : 0 à 300, pas 25,  défaut 0
// Power BI crée automatiquement les mesures [Valeur Choc retraits %], etc.
// Puis une table de sélection de la devise choquée (Modélisation > Nouvelle table) :
//
// Devises choquées =
// DATATABLE ( "Cible", STRING, { { "Toutes devises hors EUR" }, { "USD" }, { "CAD" }, { "Couronnes nordiques" }, { "Franc CFA" } } )

Facteur choc change =
VAR Devise = SELECTEDVALUE ( dim_filiale[code_devise] )
VAR Cible = SELECTEDVALUE ( 'Devises choquées'[Cible], "Toutes devises hors EUR" )
VAR Facteur = 1 + [Valeur Choc change %] / 100
RETURN
    SWITCH (
        TRUE (),
        Devise = "EUR", 1,
        Cible = "Toutes devises hors EUR", Facteur,
        Cible = "Franc CFA" && Devise IN { "XOF", "XAF" }, Facteur,
        Cible = "Couronnes nordiques" && Devise IN { "SEK", "NOK", "DKK" }, Facteur,
        Devise = Cible, Facteur,
        1
    )

Position stressée (EUR) =
SUMX (
    VALUES ( dim_filiale[code_filiale] ),
    ( [Position de trésorerie (EUR)] - [Encours de dépôts (EUR)] * [Valeur Choc retraits %] / 100 )
        * [Facteur choc change]
)

// Moyenne sur 30 jours (variable dbt fenetre_moyenne_flux_jours), comme mart_stress_test : un mois complet
// lisse le cycle des salaires et des prélèvements.
Flux net quotidien stressé (EUR) =
VAR DerniereDate = [Date d'arrêté]
VAR Fenetre = DATESINPERIOD ( dim_date[date_jour], DerniereDate, -30, DAY )
RETURN
    SUMX (
        VALUES ( dim_filiale[code_filiale] ),
        VAR Enc = CALCULATE ( AVERAGE ( fct_position_tresorerie_quotidienne[encaissements_eur] ), Fenetre )
        VAR Dec = CALCULATE ( AVERAGE ( fct_position_tresorerie_quotidienne[decaissements_eur] ), Fenetre )
        RETURN ( Enc - Dec * [Valeur Multiplicateur sorties] ) * [Facteur choc change]
    )

Horizon de survie (jours) =
VAR Pos = [Position stressée (EUR)]
VAR Net = [Flux net quotidien stressé (EUR)]
RETURN
    SWITCH ( TRUE (), Pos <= 0, 0, Net >= 0, BLANK (), DIVIDE ( Pos, -Net ) )

// Calculé filiale par filiale : l'excédent de l'une ne couvre pas le besoin d'une autre.
Besoin de refinancement stressé (EUR) =
SUMX (
    VALUES ( dim_filiale[code_filiale] ),
    MAX ( 0, - [Flux net quotidien stressé (EUR)] * 30 - [Position stressée (EUR)] )
)

// 0,5 = marge de refinancement (même valeur que la variable dbt marge_refinancement_pct)
Coût du refinancement stressé (EUR/an) =
VAR DerniereDate = [Date d'arrêté]
RETURN
    SUMX (
        VALUES ( dim_filiale[code_filiale] ),
        VAR Taux =
            CALCULATE ( MAX ( mart_liquidite_placement[taux_directeur_local_pct] ), dim_date[date_jour] = DerniereDate )
        RETURN [Besoin de refinancement stressé (EUR)] * ( Taux + 0.5 + [Valeur Choc taux (pb)] / 100 ) / 100
    )

Statut de résilience =
VAR Pos = [Position stressée (EUR)]
VAR H = [Horizon de survie (jours)]
RETURN
    SWITCH (
        TRUE (),
        Pos <= 0, "Critique",
        ISBLANK ( H ) || H >= 30, "Résilient",
        H >= 7, "Vigilance",
        "Critique"
    )

// Pour la mise en forme conditionnelle (Format > Couleur > Valeur du champ)
Couleur statut =
SWITCH ( [Statut de résilience], "Résilient", "#1B7F3B", "Vigilance", "#C77700", "#B42318" )

// ------------------------------------------------- 7. QUALITÉ DES DONNÉES SOURCES (ETL)
Lignes brutes reçues = SUM ( mart_qualite_sources[nb_lignes_brutes] )
Lignes retenues après nettoyage = SUM ( mart_qualite_sources[nb_lignes_retenues] )
Taux de rejet % = DIVIDE ( [Lignes brutes reçues] - [Lignes retenues après nettoyage], [Lignes brutes reçues] )
Doublons supprimés = SUM ( mart_qualite_sources[nb_doublons] )
Libellés corrigés = SUM ( mart_qualite_sources[nb_libelles_corriges] )
Devises corrigées = SUM ( mart_qualite_sources[nb_devises_corrigees] )
Opérations annulées, tests et extournes écartés =
SUM ( mart_qualite_sources[nb_annulees] ) + SUM ( mart_qualite_sources[nb_comptes_test] ) + SUM ( mart_qualite_sources[nb_extournes] )
Rejets inattendus = SUM ( mart_qualite_sources[nb_rejets_inattendus] )

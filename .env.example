# Copier ce fichier en ".env" puis adapter les valeurs.

# --- Connexion PostgreSQL (utilisée par Python ET par dbt) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cresus

# --- Kaggle (optionnel : sinon télécharger le CSV à la main dans data/raw/) ---
# Jeton à générer sur https://www.kaggle.com/settings  -> "Create New Token"
# KAGGLE_USERNAME=votre_login
# KAGGLE_KEY=votre_cle

# --- Paramètres de prévision ---
# Nombre de trajectoires simulées. Le code en lance au moins 1 000 pour les flux et 2 000 pour le
# change : une valeur plus petite est sans effet, une valeur plus grande les augmente toutes les deux.
PREVISION_NB_SIMULATIONS=1000
PREVISION_CHANGE_HORIZON_JOURS=30

# --- Exports bruts chargés par l'étape load. Par défaut : le jeu versionné (data/sources_internes).
# À décommenter après avoir généré le gros volume (python pipeline.py --regenerer --taille-lot 50) :
# DOSSIER_SOURCES_INTERNES=data/generees/lot_50
